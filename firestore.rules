rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return (isSignedIn() && (
        request.auth.token.email in ['modelatech2026@gmail.com', 'sushoovandas@gmail.com', 'deb491136@gmail.com', 'ghoshdebrupa005@gmail.com', 'YOUR_EXACT_GOOGLE_EMAIL@gmail.com', 'your_exact_google_email@gmail.com'] ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['Super Admin', 'SUPER_ADMIN', 'SUPERADMIN', 'super_admin']) ||
        (exists(/databases/$(database)/documents/access_requests/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/access_requests/$(request.auth.uid)).data.assignedRole in ['Super Admin', 'SUPER_ADMIN', 'SUPERADMIN', 'super_admin'])
      ));
    }

    function isHRAdmin() {
      return isSuperAdmin() || (isSignedIn() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['HR Admin', 'Super Admin', 'HR_ADMIN', 'SUPER_ADMIN', 'HR Manager', 'HR_MANAGER', 'hr_admin', 'super_admin', 'admin', 'ADMIN'])) ||
        (exists(/databases/$(database)/documents/access_requests/$(request.auth.uid)) &&
          (get(/databases/$(database)/documents/access_requests/$(request.auth.uid)).data.assignedRole in ['HR Admin', 'Super Admin', 'HR_ADMIN', 'SUPER_ADMIN', 'HR Manager', 'HR_MANAGER', 'hr_admin', 'super_admin', 'admin', 'ADMIN'] ||
           get(/databases/$(database)/documents/access_requests/$(request.auth.uid)).data.role in ['HR Admin', 'Super Admin', 'HR_ADMIN', 'SUPER_ADMIN', 'HR Manager', 'HR_MANAGER', 'hr_admin', 'super_admin', 'admin', 'ADMIN']))
      ));
    }

    // Access Requests: Single source of truth for login/access requests
    match /access_requests/{requestId} {
      // Allow users to create their own access request with status: "pending" / "PENDING"
      allow create: if request.resource.data.status in ["pending", "PENDING"];
      // Allow HR/Super Admin full management, or applicant to re-sync pending status on their own record
      allow update: if isHRAdmin() || (
        (resource.data.status in ["pending", "PENDING"] && request.resource.data.status in ["pending", "PENDING"]) &&
        (isSignedIn() && (request.auth.uid == requestId || request.auth.uid == resource.data.userId || request.auth.uid == resource.data.uid))
      );
      allow delete: if isSuperAdmin();
      // Allow HR Admin / Super Admin to read all, or applicant user to read their own request
      allow read: if isHRAdmin() || (
        isSignedIn() && (
          request.auth.uid == requestId ||
          request.auth.uid == resource.data.userId ||
          request.auth.uid == resource.data.uid ||
          request.auth.token.email == resource.data.userEmail ||
          request.auth.token.email == resource.data.email
        )
      );
    }

    // Auxiliary pending_requests collection
    match /pending_requests/{requestId} {
      allow create: if request.resource.data.status == "PENDING";
      allow read, write: if isSuperAdmin();
    }

    // User accounts
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if request.resource.data.status == "PENDING" || isSuperAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow update: if isSuperAdmin() || (isSignedIn() && request.auth.uid == userId) || (resource.data.status == "PENDING" && request.resource.data.status == "PENDING");
      allow delete: if isSuperAdmin();
    }

    // Employee Master
    match /employees/{employeeId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isHRAdmin();
    }

    // Activity Logs (Append-only)
    match /activityLogs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false; // strictly immutable append-only
    }
  }
}
